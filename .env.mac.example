STACK_ROLE=workers
COMPOSE_PROJECT_NAME=clip-workers
WORKER_AUTODEPLOY=1
WORKER_ENDPOINT=workers.example.com:443
CPU_WORKER_ID=clip-mac-cpu
CPU_WORKER_TOKEN_PATH=/path/to/clip-mac-cpu.token
COMPOSE_PROFILES=cpu
CLIP_MODEL=ViT-B/32
CLIP_PRETRAIN=laion2b_s34b_b79k
CPU_MEMORY_LIMIT=2g
CPU_LIMIT=2
CPU_THREADS=2
WORKER_UID=501
WORKER_GID=20
