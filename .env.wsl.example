STACK_ROLE=workers
COMPOSE_PROJECT_NAME=clip-workers
WORKER_AUTODEPLOY=1
WORKER_ENDPOINT=workers.example.com:443
CPU_WORKER_ID=clip-wsl-cpu
CPU_WORKER_TOKEN_PATH=/path/to/clip-wsl-cpu.token
COMPOSE_PROFILES=cpu,gpu
CLIP_MODEL=ViT-B/32
CLIP_PRETRAIN=laion2b_s34b_b79k
CPU_MEMORY_LIMIT=2g
CPU_LIMIT=2
CPU_THREADS=2
GPU_WORKER_ID=clip-wsl-gpu
GPU_WORKER_TOKEN_PATH=/path/to/clip-wsl-gpu.token
GPU_MEMORY_LIMIT=2g
GPU_CPU_LIMIT=1
WORKER_UID=1000
WORKER_GID=1000
GPU_PRECISION=fp16
CPU_PRECISION=fp32
